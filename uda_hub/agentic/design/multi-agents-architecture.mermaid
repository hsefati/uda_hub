graph TD
    %% Start and Entry
    __start__([__start__]) --> entry_bridge[entry_bridge]
    entry_bridge --> concierge[concierge]

    %% Concierge Triage Routing
    concierge -.-> |greeting| __end__([__end__])
    concierge -.-> |closure| archivist[archivist]
    concierge -.-> |need_user_response| archivist
    concierge -.-> |support_request| enricher[enricher]

    %% The Heavy Path
    enricher --> historian[historian]
    historian --> classifier[classifier]

    %% Specialist Routing
    classifier -.-> |researcher| researcher[researcher]
    classifier -.-> |escalator| escalator[escalator]

    %% Research and QA Loop
    researcher -.-> |drafter| drafter[drafter]
    researcher -.-> |escalator| escalator
    
    drafter --> policy_checker[policy_checker]
    policy_checker -.-> |FAIL| drafter
    policy_checker -.-> |PASS| archivist

    %% Finalization
    escalator --> archivist
    archivist --> __end__

    %% Database Access (Cylinders)
    subgraph Databases
        cultpass_db[(cultpass.db)]
        udahub_db[(udahub.db)]
    end

    %% Database Links
    enricher -.-> |"Read: users, subscriptions"| cultpass_db
    historian -.-> |"Read: tickets, ticket_messages"| udahub_db
    researcher -.-> |"Read: knowledge (KB)"| udahub_db
    archivist -.-> |"Write: ticket_messages, metadata"| udahub_db